<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Plone Control Panel Tool"
        name="portal_controlpanel"
        i18n:domain="collective.routes"
>

  <configlet action_id="lockdown"
             appId="wildcard.lockdown"
             category="Products"
             condition_expr=""
             icon_expr="string:${portal_url}/++resource++lockdown.png"
             title="Lockdown"
             url_expr="string:${portal_url}/@@lockdown-settings"
             visible="True"
             i18n:attributes="title"
  >
    <permission>Manage portal</permission>
  </configlet>

</object>
